# Copy to .env and edit. The Makefile reads it, so every target gets these
# without you passing them. .env is gitignored: it points at data, and the
# data does not belong in this repository.

# The config to read and write. Keep it outside this repository.
REPO_VIZ_CONFIG=../config/org.viz.yaml

# Defaults for `make scan`.
ROOT=~/src
OWNERS=Acme
SINCE=2020-01-01

# The default repo for `make analyze` and `make viz`.
REPO=~/src/some-repo
